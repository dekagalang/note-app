{
  "name": "itsnotes",
  "version": "1.0.0",
  "description": "itsnotes — a personal notes app built with Node.js and PostgreSQL",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "server": "cd server && npm start",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install": "cd server && npm install && cd ../client && npm install",
    "test": "cd server && npm test && cd ../client && npm test",
    "android:build": "npm run android:build:debug",
    "android:build:debug": "cd client && npm run android:build:debug",
    "android:build:production": "cd client && npm run android:build:production",
    "android:build:release": "cd client && npm run android:build:release",
    "android:open": "cd client && npx cap open android"
  },
  "dependencies": {
    "concurrently": "^8.2.0",
    "html-to-text": "^9.0.5",
    "react-textarea-autosize": "^8.5.7",
    "uuid": "^11.1.0"
  }
}
